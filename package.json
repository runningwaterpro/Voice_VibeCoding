{
  "name": "xiaomi-remote-2-pro",
  "version": "1.2.0",
  "description": "Voice VibeCoding — RC003 遥控器语音热键与音频传输工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:winuhid-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-winuhid-install.ps1",
    "test:rust": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:rust:run": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:ci": "cargo metadata --manifest-path src-tauri/Cargo.toml --locked --no-deps --format-version 1 && npm run format:check && npm test && npm run build && npm run test:rust && npm run test:winuhid-install",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
  }
}
